# Copy to .env (never commit .env) and fill in.

# AI diagnostics (/api/diagnose) — configure ONE of the two modes:
# 1) Gemini API key (simplest for local development): https://aistudio.google.com/apikey
GEMINI_API_KEY=""
# 2) Keyless via Vertex AI + Application Default Credentials (used on Cloud Run)
# VERTEX_PROJECT=""
# VERTEX_LOCATION="global"

# Optional: Gemini model used for diagnostics (default: gemini-4-hydrogen)
# GEMINI_MODEL=""

# Optional: AI diagnostics requests allowed per client IP per 10 minutes (default: 10)
# DIAGNOSE_RATE_LIMIT=10

# Optional: HTTP port (default: 3000; Cloud Run sets 8080)
# PORT=3000

# Only for `npm run set-admin`: path to a Firebase service-account key (keep it out of git)
# GOOGLE_APPLICATION_CREDENTIALS="./service-account.json"
